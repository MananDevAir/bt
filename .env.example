# Environment variables for the Signal Bot
# Copy this file to .env and fill in your values.

# === REQUIRED ===
# Your Discord Webhook URL — get it from: Server Settings > Integrations > Webhooks
# For threading support, create a webhook inside a Forum channel (not a regular text channel).
DISCORD_WEBHOOK_URL=

# === OPTIONAL (future use) ===
# Uncomment these only if you switch back to Telegram as the alert provider.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# LLM narration keys (currently disabled via config.yaml — llm.enabled: false)
# GROQ_API_KEY=
# HF_TOKEN=